{
  "$schema": "https://pg-language-server.com/latest/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignore": []
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "db": {
    "connectionString": "postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable",
    "host": "127.0.0.1",
    "port": 5432,
    "username": "dev",
    "password": "dev",
    "database": "dev",
    "connTimeoutSecs": 10,
    "allowStatementExecutionsAgainst": [
      "127.0.0.1/*",
      "localhost/*"
    ]
  }
}
